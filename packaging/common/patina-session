#!/bin/sh
# Starts a Patina Wayland session. Installed to /usr/bin/patina-session.
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Patina
export XDG_SESSION_DESKTOP=Patina
if command -v dbus-run-session >/dev/null 2>&1 && [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
  exec dbus-run-session -- patina-compositor "$@"
fi
exec patina-compositor "$@"
