#!/usr/bin/make -f
# Needs Rust 1.85 or newer, which is newer than the Rust in Debian 12 and Ubuntu 22.04.
# packaging/debian/build.sh installs the pinned toolchain from packaging/RUST_VERSION and
# then runs dpkg-buildpackage; calling dpkg-buildpackage directly works if cargo is new enough.
# The build downloads crates from crates.io, so it needs network access.

export CARGO_TARGET_DIR = $(CURDIR)/target
BINARIES = -p patina-compositor -p patina-panel -p patina-dock -p patina-lock -p patina-greeter -p patina-apps

include /usr/share/dpkg/architecture.mk

# Cross builds (dpkg-buildpackage -a amd64 on arm64, or the other way round): build for the
# host architecture's Rust target with its cross linker, and find its libraries through
# multiarch. The binaries are copied to target/release so the install file is the same.
ifneq ($(DEB_BUILD_GNU_TYPE),$(DEB_HOST_GNU_TYPE))
RUST_TARGET = $(DEB_HOST_GNU_CPU)-unknown-linux-gnu
RUST_TARGET_ENV = $(shell echo $(RUST_TARGET) | tr a-z- A-Z_)
export CARGO_TARGET_$(RUST_TARGET_ENV)_LINKER = $(DEB_HOST_GNU_TYPE)-gcc
export PKG_CONFIG_ALLOW_CROSS = 1
export PKG_CONFIG_LIBDIR = /usr/lib/$(DEB_HOST_MULTIARCH)/pkgconfig:/usr/share/pkgconfig
CARGO_TARGET_FLAG = --target $(RUST_TARGET)
endif

%:
	dh $@

override_dh_auto_configure:
	@v=$$(rustc --version | sed -E 's/rustc ([0-9]+)\.([0-9]+).*/\1 \2/'); \
	set -- $$v; \
	if [ "$$1" -lt 1 ] || { [ "$$1" -eq 1 ] && [ "$$2" -lt 85 ]; }; then \
	  echo "error: Rust 1.85 or newer is required, found $$(rustc --version)." >&2; \
	  echo "       Run packaging/debian/build.sh, which installs the pinned toolchain." >&2; \
	  exit 1; \
	fi

override_dh_auto_build:
	cargo build --release --locked $(CARGO_TARGET_FLAG) $(BINARIES)
ifdef RUST_TARGET
	mkdir -p target/release
	cp $(addprefix target/$(RUST_TARGET)/release/,patina-compositor patina-panel patina-dock patina-lock patina-greeter patina-autostart patina-session-ctl) target/release/
endif
	python3 packaging/common/crate-licenses.py > debian/third-party-crates.txt

# Tests run on the build machine, so not in a cross build.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS))$(RUST_TARGET))
	cargo test --release --locked -p patina-tokens -p patina-frame -p patina-panel -p patina-apps -p patina-signin
endif

override_dh_auto_clean:
	rm -f debian/third-party-crates.txt

override_dh_installdocs:
	dh_installdocs
	install -Dm644 debian/third-party-crates.txt debian/patina-desktop/usr/share/doc/patina-desktop/third-party-crates.txt

# Rust's DWARF trips up dwz, and the symbols are not needed in a pre-release package.
override_dh_dwz:

override_dh_strip:
	dh_strip --no-automatic-dbgsym

# xz everywhere: Debian 12's tools and older dpkg can read it, zstd is not universal.
override_dh_builddeb:
	dh_builddeb -- -Zxz

# The lock screen's PAM service is patina-lock, not the package name.
override_dh_installpam:
	dh_installpam --name=patina-lock
